# ── Anthropic ─────────────────────────────────────────────
# Evaluador: usa Claude si hay ANTHROPIC_API_KEY real; si no, OpenAI.
# EVAL_PROVIDER=openai      # openai | anthropic
# OPENAI_API_KEY=sk-...
# EVAL_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-...

# ── LinkedIn ──────────────────────────────────────────────
LINKEDIN_EMAIL=tu@email.com
LINKEDIN_PASSWORD=tu_contraseña

# ── Notificaciones ────────────────────────────────────────
# Correo que recibirá el resumen de casos "consultar"
NOTIFY_EMAIL=darwing@adr.com.pe

# SMTP (Gmail con contraseña de app, o cualquier servidor)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=app_password_aqui

# Opcional: webhook de Slack en lugar de (o además de) email
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Umbrales de decisión ──────────────────────────────────
SCORE_ACCEPT=7       # score >= este valor → aceptar automáticamente
SCORE_IGNORE=4       # score <  este valor → ignorar

# ── Límites de seguridad ──────────────────────────────────
MAX_ACCEPTS_PER_SESSION=10   # máximo de aceptaciones por ejecución
MAX_ACCEPTS_PER_WEEK=30      # hard cap semanal

# ── Archivos de estado ────────────────────────────────────
SESSION_FILE=data/session.json   # cookies de LinkedIn
LOG_FILE=logs/agent.log
DATA_FILE=data/pending_requests.json   # solicitudes extraídas por el scraper
DECISIONS_CSV=data/decisions.csv        # historial de decisiones
WEEKLY_COUNT_FILE=data/weekly_count.json

# ── Candado ───────────────────────────────────────────────
# 0 = todo corre como simulación (no acepta en LinkedIn). Cambiar a 1 SOLO con autorización de Darwing.
LINKEDIN_AGENT_LIVE=0

# Solicitudes nuevas a leer por corrida
MAX_PER_RUN=25
